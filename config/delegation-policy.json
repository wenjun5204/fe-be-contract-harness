{
  "$schema": "https://harness.dev/schemas/delegation-policy-v1.json",
  "version": "1",
  "receipt_schema": "stage-subagent/v1",
  "required_stages": ["0", "1", "2", "3", "4", "5A", "5B", "6", "7", "8", "9", "10"],
  "stage_subagent": {
    "0": "orchestrator/init",
    "1": "orchestrator/requirements-analyst",
    "2": "contract/contract-designer",
    "3": "orchestrator/services-analyst",
    "4": "orchestrator/git-client",
    "5A": {
      "by_stack": {
        "node": "codegen/node-codegen",
        "java": "codegen/java-codegen"
      },
      "skip_subagent": "codegen/node-codegen"
    },
    "5B": {
      "by_stack": {
        "react": "codegen/react-codegen",
        "vue": "codegen/vue-codegen",
        "react_native": "codegen/rn-codegen",
        "expo": "codegen/rn-codegen"
      },
      "skip_subagent": "codegen/react-codegen"
    },
    "6": "contract/consistency-checker",
    "7": "quality/code-review",
    "8": {
      "default": "quality/test-case-generator",
      "by_stack": {
        "react": "quality/test-case-generator",
        "vue": "quality/test-case-generator",
        "react_native": "quality/test-case-generator",
        "expo": "quality/test-case-generator",
        "node": "quality/test-case-generator",
        "java": "quality/test-case-generator",
        "quality/test-executor": "quality/test-executor",
        "quality/test-failure-analyzer": "quality/test-failure-analyzer",
        "quality/test-fixer": "quality/test-fixer"
      },
      "skip_subagent": "quality/test-case-generator"
    },
    "9": "orchestrator/deployer",
    "10": "orchestrator/notifier"
  }
}
