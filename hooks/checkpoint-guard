#!/usr/bin/env python3
"""checkpoint-guard:阶段卡点校验(设计文档 §10 / 第一阶段 hook 协议)。

输入(事件):
    {"stage": "2", "response": "approve|confirm|ok|yes|skip|其他"}
旧位置参数(兼容): checkpoint-guard <stage_id> [response]
输出: {"allow": bool, "code"?, "decision"?, "checkpoint"?, "reason"?}
      退出码 0 放行(无卡点 / approve / 合法 skip);1 阻断(revise / 非法 skip);2 协议错误
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.checkpoint_manager import decide  # noqa: E402
from lib.hook_protocol import UsageError, allow, block, emit, read_event  # noqa: E402


def _from_args(argv):
    if len(argv) < 1:
        raise UsageError("usage: checkpoint-guard <stage_id> [response]")
    return {"stage": argv[0], "response": argv[1] if len(argv) > 1 else ""}


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    try:
        ev = read_event(argv, _from_args)
        stage = ev.get("stage")
        response = ev.get("response")
        if not stage:
            raise UsageError("缺少 stage")
        res = decide(stage, response)
        if res["decision"] in (None, "approve", "skip") and res["ok"]:
            return emit(allow(stage=stage, decision=res["decision"], checkpoint=res["checkpoint"]))
        return emit(block(
            "CHECKPOINT_BLOCKED" if not res["ok"] else "CHECKPOINT_REVISE",
            res.get("reason") or f"checkpoint {res['checkpoint']} 要求修订",
            stage=stage, decision=res["decision"], checkpoint=res["checkpoint"],
        ))
    except UsageError as e:
        print(json.dumps({"allow": False, "code": "BAD_REQUEST", "message": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
