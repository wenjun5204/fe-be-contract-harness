#!/usr/bin/env python3
"""pre-edit-guard:保护契约与生成区文件不被未授权编辑(设计文档 §8.1 / 第一阶段 hook 协议)。

输入(事件):
    {"file_path": "...", "contract": "...", "allow_generated": bool}
旧位置参数(兼容): pre-edit-guard <file_path> [--contract <path>] [--allow-generated]
输出: {"allow": bool, "code"?, "reason"?, "file"?}
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.hook_protocol import UsageError, allow, block, emit, read_event  # noqa: E402

CONTRACT_NAMES = ("openapi.yaml", "openapi.yml", "openapi.json", "swagger.yaml", "swagger.json")


def is_protected(path: Path, contract_path: str | None = None):
    if contract_path and path.resolve() == Path(contract_path).resolve():
        return "契约文件(SSOT,不可直接编辑)"
    if path.name.lower() in CONTRACT_NAMES:
        return "契约文件(SSOT,不可直接编辑)"
    try:
        if not path.exists():
            return None
        text = path.read_text(encoding="utf-8", errors="ignore")
        if "勿手改" in text:
            return "生成区文件(含「勿手改」标记,重生成会覆盖)"
        if ("openapi:" in text or "swagger:" in text) and "paths:" in text:
            return "契约文件(SSOT,不可直接编辑)"
    except OSError:
        pass
    return None


def _from_args(argv):
    if len(argv) < 1:
        raise UsageError("usage: pre-edit-guard <file_path> [--contract <path>] [--allow-generated]")
    ev = {"file_path": argv[0], "allow_generated": "--allow-generated" in argv}
    if "--contract" in argv:
        i = argv.index("--contract")
        if i + 1 < len(argv):
            ev["contract"] = argv[i + 1]
    return ev


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    try:
        ev = read_event(argv, _from_args)
        file_path = ev.get("file_path")
        if not file_path:
            raise UsageError("缺少 file_path")
        reason = is_protected(Path(file_path), ev.get("contract"))
        if reason and not ev.get("allow_generated"):
            return emit(block("PROTECTED_FILE", reason, file=file_path, reason=reason))
        return emit(allow(file=file_path))
    except UsageError as e:
        print(json.dumps({"allow": False, "code": "BAD_REQUEST", "message": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
