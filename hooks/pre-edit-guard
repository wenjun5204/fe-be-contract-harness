#!/usr/bin/env python3
"""pre-edit-guard:保护契约与生成区文件不被未授权编辑(设计文档 §8.1)。

用法:
    pre-edit-guard <file_path> [--contract <path>] [--allow-generated]

阻断规则:
1. 显式契约路径(--contract 指定)或文件名命中 openapi/swagger.*
2. 内容含「勿手改」的生成区文件
3. 内容含 openapi:/swagger: 且 paths: 的契约文件(按内容识别)

退出码:0 放行;1 阻断;2 参数错误
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

CONTRACT_NAMES = ("openapi.yaml", "openapi.yml", "openapi.json", "swagger.yaml", "swagger.json")


def is_protected(path: Path, contract_path: str | None = None):
    if contract_path and path.resolve() == Path(contract_path).resolve():
        return "契约文件(SSOT,不可直接编辑)"
    if path.name.lower() in CONTRACT_NAMES:
        return "契约文件(SSOT,不可直接编辑)"
    try:
        if not path.exists():
            return None
        text = path.read_text(encoding="utf-8", errors="ignore")
        if "勿手改" in text:
            return "生成区文件(含「勿手改」标记,重生成会覆盖)"
        if ("openapi:" in text or "swagger:" in text) and "paths:" in text:
            return "契约文件(SSOT,不可直接编辑)"
    except OSError:
        pass
    return None


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    if len(argv) < 1:
        print("usage: pre-edit-guard <file_path> [--contract <path>] [--allow-generated]", file=sys.stderr)
        return 2
    path = Path(argv[0])
    allow_generated = "--allow-generated" in argv
    contract_path = None
    if "--contract" in argv:
        i = argv.index("--contract")
        if i + 1 < len(argv):
            contract_path = argv[i + 1]
    reason = is_protected(path, contract_path)
    if reason and not allow_generated:
        print(json.dumps({"ok": False, "file": str(path), "reason": reason}, ensure_ascii=False))
        return 1
    print(json.dumps({"ok": True, "file": str(path)}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
