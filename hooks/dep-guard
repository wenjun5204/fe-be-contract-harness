#!/usr/bin/env python3
"""dep-guard:依赖检查(设计文档 §8.1 / 第一阶段 hook 协议)。

输入(事件): 可忽略(不依赖事件内容)
输出: {"allow": bool, "missing": [...]}
"""
from __future__ import annotations

import json
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.hook_protocol import UsageError, emit, read_event  # noqa: E402


def check_deps() -> list:
    missing = []
    if shutil.which("python3") is None:
        missing.append("python3")
    if shutil.which("node") is None:
        missing.append("node")
    try:
        import yaml  # noqa: F401
    except ImportError:
        missing.append("pyyaml (pip3 install pyyaml)")
    return missing


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    try:
        read_event(argv)  # 仅用于协议统一;dep-guard 不依赖事件内容
    except UsageError:
        pass  # 无事件也允许(纯环境检查)
    missing = check_deps()
    if missing:
        return emit({"allow": False, "missing": missing, "suggestion": f"请安装: {', '.join(missing)}"})
    return emit({"allow": True, "missing": []})


if __name__ == "__main__":
    sys.exit(main())
