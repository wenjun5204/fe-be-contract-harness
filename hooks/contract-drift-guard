#!/usr/bin/env python3
"""contract-drift-guard:契约漂移守卫(设计文档 §8.2 / 第一阶段 hook 协议)。

输入(事件):
    {"contract": "...", "stack": "node", "gen_dir": "gen/node"}
旧位置参数(兼容): contract-drift-guard <contract> <stack> <gen-dir>
输出: {"allow": bool, "code"?, "reason"?, "drift"?}
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.contract.consistency import drift_check  # noqa: E402
from lib.hook_protocol import UsageError, allow, block, emit, read_event  # noqa: E402


def _from_args(argv):
    if len(argv) < 3:
        raise UsageError("usage: contract-drift-guard <contract> <stack> <gen-dir>")
    return {"contract": argv[0], "stack": argv[1], "gen_dir": argv[2]}


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    try:
        ev = read_event(argv, _from_args)
        contract = ev.get("contract")
        stack = ev.get("stack")
        gen_dir = ev.get("gen_dir")
        if not (contract and stack and gen_dir):
            raise UsageError("缺少 contract / stack / gen_dir")
        r = drift_check(contract, stack, gen_dir)
        if r["ok"]:
            return emit(allow(stack=stack, drift=False))
        return emit(block(
            "CONTRACT_DRIFT", r.get("reason") or "契约与生成产物漂移",
            stack=stack,
            drift={"routes_drift": r.get("routes_drift"), "models_drift": r.get("models_drift")},
        ))
    except UsageError as e:
        print(json.dumps({"allow": False, "code": "BAD_REQUEST", "message": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
