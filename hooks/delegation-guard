#!/usr/bin/env python3
"""delegation-guard:fail-closed 委派校验(设计文档 §15.4)。

用法:
    delegation-guard <stage_id> <receipt_json> <outputs_json>
    其中 receipt_json / outputs_json 为 JSON 字符串(无则传 null)

退出码:0 放行;1 阻断;2 参数错误
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.delegation import validate_dispatch  # noqa: E402


def _parse(s: str):
    if s in ("", "null", "None"):
        return None
    return json.loads(s)


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    if len(argv) < 3:
        print("usage: delegation-guard <stage_id> <receipt_json> <outputs_json>", file=sys.stderr)
        return 2
    stage = argv[0]
    try:
        receipt = _parse(argv[1])
        outputs = _parse(argv[2])
    except json.JSONDecodeError as e:
        print(f"JSON 解析失败: {e}", file=sys.stderr)
        return 2
    res = validate_dispatch(stage, receipt, outputs)
    print(json.dumps(res, ensure_ascii=False, indent=2))
    return 0 if res["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
