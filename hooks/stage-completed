#!/usr/bin/env python3
"""stage-completed:阶段完成后 DAG 路由下一阶段(设计文档 §8.1)。

用法:
    stage-completed <state_file> <stage_id>

动作:标记 stage_id 为 completed,返回下一可推进阶段列表。
退出码:0 成功;1 失败;2 参数错误
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.state_manager import actionable_stages, set_stage_state  # noqa: E402


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    if len(argv) < 2:
        print("usage: stage-completed <state_file> <stage_id>", file=sys.stderr)
        return 2
    sf = Path(argv[0])
    stage = argv[1]
    try:
        set_stage_state(sf, stage, "completed")
    except (FileNotFoundError, KeyError) as e:
        print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 1
    nxt = actionable_stages(sf)
    print(json.dumps({"ok": True, "completed": stage, "next": nxt}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
