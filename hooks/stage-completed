#!/usr/bin/env python3
"""stage-completed:阶段完成事件 → 唯一 transition 入口,门控后路由下一阶段(设计文档 §8.1 / 第一阶段)。

不再直接写 state.json;完成一个阶段必须通过 lib.transition(FSM + 前置 + 产出 +
receipt + checkpoint + evidence 全门控)。checkpoint 未决时返回 checkpoint_pending 等待人工。

输入(事件):
    {
      "state_file": "state.json",
      "stage": "5A",
      "outputs": {...},
      "receipt": {...},
      "checkpoint_decision": "approve" | "skip" | "revise" | null,
      "evidence": [...],
      "auto_approve": bool,
      "skip": bool,            # 显式跳过模式
      "skip_reason": "...",    # skip 模式必填
      "approved_by": "..."     # skip 模式必填(mandatory_review)
    }
旧位置参数(兼容): stage-completed <state_file> <stage_id>
输出: {"allow": bool, "stage", "status", "next": [...]}
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.hook_protocol import UsageError, block, emit, read_event  # noqa: E402
from lib.state_manager import actionable_stages, read_state  # noqa: E402
from lib.transition import TransitionError, complete_stage, skip_stage, start_stage  # noqa: E402


def _from_args(argv):
    if len(argv) < 2:
        raise UsageError("usage: stage-completed <state_file> <stage_id>")
    return {"state_file": argv[0], "stage": argv[1]}


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    try:
        ev = read_event(argv, _from_args)
        sf = Path(ev.get("state_file") or "state.json")
        stage = ev.get("stage")
        if not stage:
            raise UsageError("缺少 stage")

        try:
            if ev.get("skip"):
                res = skip_stage(
                    sf, stage,
                    reason=ev.get("skip_reason") or "",
                    approved_by=ev.get("approved_by") or "",
                    receipt=ev.get("receipt"),
                    evidence=ev.get("evidence"),
                )
            else:
                # pending 阶段先 start(校验前置),再 complete(产出/receipt/checkpoint 门控)
                if read_state(sf)["stages"][stage]["state"] == "pending":
                    start_stage(sf, stage)
                res = complete_stage(
                    sf, stage,
                    outputs=ev.get("outputs"),
                    receipt=ev.get("receipt"),
                    checkpoint_decision=ev.get("checkpoint_decision"),
                    evidence=ev.get("evidence"),
                    auto_approve=bool(ev.get("auto_approve")),
                )
        except TransitionError as e:
            return emit(block(
                "TRANSITION_BLOCKED", str(e),
                stage=stage,
                reasons=e.reasons,
            ))

        nxt = actionable_stages(sf)
        return emit({
            "allow": True,
            "stage": stage,
            "status": res.get("status"),
            "message": res.get("message"),
            "next": nxt,
        })
    except UsageError as e:
        print(json.dumps({"allow": False, "code": "BAD_REQUEST", "message": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
