#!/usr/bin/env python3
"""coverage-guard:提交前覆盖率门控(设计文档 §14.4)。

用法:
    coverage-guard <report_json>
    report_json 形如 '{"changed_line": 55.0, "new_file": null, "delta_drop": 1.2}'

退出码:0 达标;1 不达标;2 参数错误
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.coverage_gate import check_coverage  # noqa: E402


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    if len(argv) < 1:
        print("usage: coverage-guard <report_json>", file=sys.stderr)
        return 2
    try:
        report = json.loads(argv[0])
    except json.JSONDecodeError as e:
        print(f"JSON 解析失败: {e}", file=sys.stderr)
        return 2
    r = check_coverage(report)
    print(json.dumps(r, ensure_ascii=False, indent=2))
    return 0 if r["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
