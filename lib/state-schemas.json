{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lib/state-schemas.json",
  "title": "fe-be-contract-harness pipeline state",
  "description": "pipeline 状态文件(state.json)结构定义,由 lib/state_manager.py 读写",
  "type": "object",
  "required": ["change_id", "workflow_source", "stages"],
  "properties": {
    "change_id": { "type": "string" },
    "workflow_source": { "type": "string", "const": "local" },
    "current_stage": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "stages": {
      "type": "object",
      "description": "stage_id -> 阶段状态与产出(终态必须经 lib/transition.py 门控写入)",
      "additionalProperties": {
        "type": "object",
        "required": ["state", "outputs"],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "checkpoint_pending",
              "interaction_waiting",
              "checkpoint_confirmed",
              "completed",
              "skipped",
              "failed"
            ]
          },
          "outputs": { "type": "object" },
          "receipt": {
            "type": ["object", "null"],
            "description": "dispatch receipt(委派 fail-closed 凭证)"
          },
          "checkpoint": {
            "type": ["object", "null"],
            "description": "人工卡点记录:{type, decision, approved_by, at}",
            "properties": {
              "type": { "type": "string" },
              "decision": { "type": "string", "enum": ["approve", "skip", "revise"] },
              "approved_by": { "type": "string" },
              "at": { "type": "string" }
            }
          },
          "skip": {
            "type": ["object", "null"],
            "description": "显式跳过记录:{reason, approved_by, at}",
            "properties": {
              "reason": { "type": "string" },
              "approved_by": { "type": "string" },
              "at": { "type": "string" }
            }
          },
          "error": {
            "type": ["object", "null"],
            "description": "失败记录:{reason, at}"
          },
          "evidence": {
            "type": "array",
            "description": "可验证证据链:[{type, detail, at}]",
            "items": { "type": "object" }
          },
          "completed_at": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
